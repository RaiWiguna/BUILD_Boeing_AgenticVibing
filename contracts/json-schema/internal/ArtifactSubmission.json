{
  "$defs": {
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "derivative_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "AUDIO_DERIVATIVE",
        "JSON_REPORT",
        "CSV_REPORT",
        "HTML_REPORT"
      ],
      "title": "Kind",
      "type": "string"
    },
    "required_capability": {
      "enum": [
        "audio",
        "export"
      ],
      "title": "Required Capability",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Asset Id"
    },
    "source_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "transform_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Transform Version",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "analysis_run_id",
    "revision",
    "id",
    "kind",
    "sha256",
    "size_bytes",
    "source_asset_id",
    "transform_version",
    "source_range",
    "derivative_range",
    "expires_at",
    "required_capability"
  ],
  "title": "ArtifactSubmission",
  "type": "object"
}
