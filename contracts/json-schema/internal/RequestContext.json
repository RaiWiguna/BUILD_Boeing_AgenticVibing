{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "as_of_ms": {
      "minimum": 0,
      "title": "As Of Ms",
      "type": "integer"
    },
    "capabilities": {
      "items": {
        "enum": [
          "read",
          "audio",
          "review",
          "export",
          "truth",
          "analysis",
          "admin",
          "worker"
        ],
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_revision": {
      "minimum": 1,
      "title": "Input Revision",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "AS_KNOWN",
        "DEBRIEF"
      ],
      "title": "Mode",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "capabilities",
    "session_id",
    "analysis_run_id",
    "input_revision",
    "input_hash",
    "as_of_ms",
    "mode",
    "request_id"
  ],
  "title": "RequestContext",
  "type": "object"
}
