{
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "end_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "End Ms"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "AUDIO",
        "TRANSCRIPT",
        "EVENT",
        "TRACK",
        "POLICY"
      ],
      "title": "Kind",
      "type": "string"
    },
    "quote": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quote"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Segment Id"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "span_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Span End"
    },
    "span_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Span Start"
    },
    "start_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Start Ms"
    }
  },
  "required": [
    "session_id",
    "analysis_run_id",
    "revision",
    "id",
    "kind",
    "source_id",
    "segment_id",
    "start_ms",
    "end_ms",
    "quote",
    "span_start",
    "span_end",
    "source_hash"
  ],
  "title": "Evidence",
  "type": "object"
}
