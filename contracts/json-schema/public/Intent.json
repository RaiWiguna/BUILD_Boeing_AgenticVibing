{
  "$defs": {
    "CriticalSlot": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "quality": {
          "enum": [
            "SUPPORTED",
            "AMBIGUOUS",
            "MISSING",
            "CONFLICTING"
          ],
          "title": "Quality",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "quality",
        "evidence_ids",
        "alternatives",
        "unknowns"
      ],
      "title": "CriticalSlot",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Run Id"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Ms"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "AUDIO",
            "TRANSCRIPT",
            "EVENT",
            "TRACK",
            "POLICY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Segment Id"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "span_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span End"
        },
        "span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span Start"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Ms"
        }
      },
      "required": [
        "session_id",
        "analysis_run_id",
        "revision",
        "id",
        "kind",
        "source_id",
        "segment_id",
        "start_ms",
        "end_ms",
        "quote",
        "span_start",
        "span_end",
        "source_hash"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "enum": [
          "HOLD_SHORT",
          "CROSS_RUNWAY",
          "LINE_UP_WAIT",
          "TAKEOFF",
          "LAND",
          "TAXI",
          "VACATE",
          "CONTACT",
          "REPORT",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "alternatives": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "available_time_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Available Time Ms"
    },
    "callsign": {
      "$ref": "#/$defs/CriticalSlot"
    },
    "condition": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Condition"
    },
    "entity_candidates": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Entity Candidates",
      "type": "array"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "negation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Negation"
    },
    "quality": {
      "enum": [
        "SUPPORTED",
        "AMBIGUOUS",
        "MISSING",
        "CONFLICTING"
      ],
      "title": "Quality",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "role_candidate": {
      "enum": [
        "CONTROLLER",
        "PILOT",
        "VEHICLE",
        "UNKNOWN"
      ],
      "title": "Role Candidate",
      "type": "string"
    },
    "runway": {
      "$ref": "#/$defs/CriticalSlot"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Segment Ids",
      "type": "array"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "speech_act": {
      "enum": [
        "REQUEST",
        "INSTRUCTION",
        "READBACK",
        "REPORT",
        "CORRECTION",
        "CANCELLATION",
        "COORDINATION",
        "HANDOFF",
        "INFORMATION",
        "UNKNOWN"
      ],
      "title": "Speech Act",
      "type": "string"
    },
    "unknowns": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "analysis_run_id",
    "revision",
    "event_time_ms",
    "available_time_ms",
    "recorded_at",
    "evidence",
    "id",
    "segment_ids",
    "speech_act",
    "role_candidate",
    "entity_candidates",
    "actions",
    "callsign",
    "runway",
    "condition",
    "negation",
    "quality",
    "alternatives",
    "unknowns"
  ],
  "title": "Intent",
  "type": "object"
}
