        "reviewer": {
          "enum": [
            "UNREVIEWED",
            "CONFIRMED",
            "DISMISSED",
            "UNRESOLVED"
          ],
          "title": "Reviewer",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "analysis_run_id",
        "revision",
        "event_time_ms",
        "available_time_ms",
        "recorded_at",
        "evidence",
        "id",
        "entity_id",
        "intent_id",
        "interpretation",
        "instruction",
        "readback",
        "movement",
        "reviewer",
        "dependency_hashes",
        "reducer_version"
      ],
      "title": "MemoryEvent",
      "type": "object"
    },
