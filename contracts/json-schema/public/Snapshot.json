{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Run Id"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Ms"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "AUDIO",
            "TRANSCRIPT",
            "EVENT",
            "TRACK",
            "POLICY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Segment Id"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "span_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span End"
        },
        "span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span Start"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Ms"
        }
      },
      "required": [
        "session_id",
        "analysis_run_id",
        "revision",
        "id",
        "kind",
        "source_id",
        "segment_id",
        "start_ms",
        "end_ms",
        "quote",
        "span_start",
        "span_end",
        "source_hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Run Id"
        },
        "applicability": {
          "enum": [
            "LAB_ONLY",
            "PARTNER_REPLAY_REVIEW"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "available_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Time Ms"
        },
        "category": {
          "enum": [
            "CRITICAL_SLOT_UNCERTAIN",
            "READBACK_DISCREPANCY",
            "OPEN_LOOP",
            "SPEECH_RECORD_DISCREPANCY",
            "MOVEMENT_DIVERGENCE",
            "QUALITY_GAP"
          ],
          "title": "Category",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "event_time_ms": {
          "minimum": 0,
          "title": "Event Time Ms",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "priority": {
          "enum": [
            "INFO",
            "NOTICE",
            "ATTENTION"
          ],
          "title": "Priority",
          "type": "string"
        },
        "quality": {
          "enum": [
            "SUPPORTED",
            "AMBIGUOUS",
            "MISSING",
            "CONFLICTING"
          ],
          "title": "Quality",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "rule_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "OPEN",
            "UNDER_REVIEW",
            "CONFIRMED",
            "DISMISSED",
            "UNRESOLVED",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "analysis_run_id",
        "revision",
        "event_time_ms",
        "available_time_ms",
        "recorded_at",
        "evidence",
        "id",
        "category",
        "statement",
        "priority",
        "status",
        "entity_ids",
        "rule_version",
        "model_version",
        "quality",
        "applicability",
        "unknowns",
        "stale"
      ],
      "title": "Finding",
      "type": "object"
    },
    "MemoryEvent": {
      "additionalProperties": false,
