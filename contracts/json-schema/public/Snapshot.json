  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "as_of_ms": {
      "minimum": 0,
      "title": "As Of Ms",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/SourceEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "memory": {
