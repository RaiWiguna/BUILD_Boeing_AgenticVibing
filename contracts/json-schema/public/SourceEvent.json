{
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "available_time_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Available Time Ms"
    },
    "entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entity Id"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "INSTRUCTION",
        "TRACK",
        "ALERT",
        "QUALITY",
        "REPORT"
      ],
      "title": "Kind",
      "type": "string"
    },
    "quality": {
      "enum": [
        "SUPPORTED",
        "AMBIGUOUS",
        "MISSING",
        "CONFLICTING"
      ],
      "title": "Quality",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "source_event_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Event Id",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Statement",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "analysis_run_id",
    "revision",
    "event_time_ms",
    "available_time_ms",
    "recorded_at",
    "id",
    "source_id",
    "source_event_id",
    "kind",
    "entity_id",
    "source_hash",
    "quality",
    "statement"
  ],
  "title": "SourceEvent",
  "type": "object"
}
