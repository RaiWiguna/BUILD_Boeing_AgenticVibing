{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "title": "Audio",
          "type": "boolean"
        },
        "gaps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TimeRange"
          },
          "title": "Gaps",
          "type": "array"
        },
        "quality": {
          "enum": [
            "SUPPORTED",
            "AMBIGUOUS",
            "MISSING",
            "CONFLICTING"
          ],
          "title": "Quality",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speaker_identity": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Speaker Identity"
        },
        "tracks": {
          "title": "Tracks",
          "type": "boolean"
        },
        "vehicles": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vehicles"
        }
      },
      "required": [
        "audio",
        "tracks",
        "vehicles",
        "speaker_identity",
        "quality"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis Run Id"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "analysis_run_id",
    "revision",
    "source_id",
    "coverage"
  ],
  "title": "SourceQualityChanged",
  "type": "object"
}
